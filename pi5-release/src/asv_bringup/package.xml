<?xml version="1.0"?>
<package format="3">
  <name>asv_bringup</name>
  <version>0.1.0</version>
  <description>Raspberry Pi 5 hardware launch package for the TAMU ASV.</description>
  <maintainer email="abbigupta.j18@gmail.com">Abhinav Gupta</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>asv_control</exec_depend>
  <exec_depend>asv_autonomy</exec_depend>
  <exec_depend>asv_sensors</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mavros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
