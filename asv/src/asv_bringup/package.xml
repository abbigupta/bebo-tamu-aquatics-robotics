<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>asv_bringup</name>
  <version>0.1.0</version>
  <description>Launch and configuration package for the TLU autonomous surface vehicle.</description>
  <maintainer email="abbi@todo.todo">abbi</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>asv_description</exec_depend>
  <exec_depend>asv_control</exec_depend>
  <exec_depend>asv_autonomy</exec_depend>
  <exec_depend>asv_localization</exec_depend>
  <exec_depend>asv_sensors</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>mavros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
